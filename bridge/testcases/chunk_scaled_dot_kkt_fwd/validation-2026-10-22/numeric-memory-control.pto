module {
  func.func @numeric_memory(%src: !pto.ptr<ui8, ub>, %dst: !pto.ptr<ui8, ub>) {
    %c0 = arith.constant 0 : index
    %value = pto.vmi.vload %src[%c0] : !pto.ptr<ui8, ub> -> !pto.vmi.vreg<64xui8>
    pto.vmi.vstore %value, %dst[%c0] : !pto.vmi.vreg<64xui8>, !pto.ptr<ui8, ub>
    return
  }
}
