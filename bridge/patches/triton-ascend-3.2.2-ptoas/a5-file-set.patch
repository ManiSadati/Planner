+def linalg_to_ptoas_vmi(linalg: str, metadata, opt):
+    linalg, metadata = _parse_linalg_metadata(linalg, metadata)
+    _validate_ptoas_launcher_contract(linalg, metadata, opt)
+    _set_ptoas_launcher_defaults(metadata)
+    with tempfile.TemporaryDirectory() as tmpdir:
+        src_path = os.path.join(tmpdir, "kernel.ttadapter.mlir")
+        dst_path = os.path.join(tmpdir, "kernel.ptovmi.mlir")
+        Path(src_path).write_text(linalg)
+        npu_compiler_path, env = _get_npucompiler_path()
+        command = (
+            [npu_compiler_path, src_path]
+            + _build_ptoas_vmi_compile_options(metadata)
+            + ["-o", dst_path]
+        )
+        _print_compile_command("bishengir-compile (PTOAS bridge)", command)
+        try:
+            subprocess.run(command, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True)
+        except subprocess.CalledProcessError as error:
+            if opt.debug:
+                _save_npuir_debug_output(error.stdout, error.stderr, tmpdir, metadata["hash"])
