+def _get_ptoas_path():
+    env = os.environ.copy()
+    explicit_path = os.getenv("TRITON_PTOAS_PATH")
+    if explicit_path:
+        candidates = [explicit_path, os.path.join(explicit_path, "ptoas")]
+        for candidate in candidates:
+            if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
+                env["PATH"] = os.path.dirname(candidate) + ":" + env.get("PATH", "")
+                return candidate, env
+        raise EnvironmentError(
+            "TRITON_PTOAS_PATH does not identify an executable ptoas binary."
+        )
+
+    ptoas_path = shutil.which("ptoas")
+    if ptoas_path is None:
+        raise EnvironmentError(
+            "Couldn't find executable ptoas. Set TRITON_PTOAS_PATH to the "
+            "PTOAS compiler path."
+        )
+    return ptoas_path, env
