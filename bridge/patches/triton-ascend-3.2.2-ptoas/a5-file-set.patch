+            ptoas_path,
+            "--pto-backend=vpto",
+            f"--pto-arch={ptoas_arch}",
+            "--emit-device-object",
+            src_path,
+            "-o",
+            dst_path,
+        ]
+        _print_compile_command("ptoas", command)
+        subprocess.run(command, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True)
+        if not Path(dst_path).exists():
+            raise FileNotFoundError(f"Expected PTOAS device object was not generated: {dst_path}")
+        result = Path(dst_path).read_bytes()
+        if opt.debug:
+            get_dump_manager(metadata["hash"]).put(result, "kernel.ptoas-device.o", binary=True)
