// Hand-authored PTOAS/VMI target for AscendNPU-IR/lowered_vector_add_kernel.mlir.
// This file freezes the Stage 1 target shape before implementing the
// whole-kernel AVE/HIVM-to-PTOAS conversion.

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func private @vector_add_kernel_outlined_vf_0(
      %lhs: !pto.ptr<f32, ub>,
      %rhs: !pto.ptr<f32, ub>,
      %dst: !pto.ptr<f32, ub>) attributes {no_inline} {
    %c0 = arith.constant 0 : index
    %c64 = arith.constant 64 : index
    %c256 = arith.constant 256 : index

    scf.for %iv = %c0 to %c256 step %c64 {
      %lhs_view = pto.addptr %lhs, %iv : !pto.ptr<f32, ub> -> !pto.ptr<f32, ub>
      %rhs_view = pto.addptr %rhs, %iv : !pto.ptr<f32, ub> -> !pto.ptr<f32, ub>
      %dst_view = pto.addptr %dst, %iv : !pto.ptr<f32, ub> -> !pto.ptr<f32, ub>

      %lhs_vec = pto.vmi.load %lhs_view[%c0]
          : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32>
      %rhs_vec = pto.vmi.load %rhs_view[%c0]
          : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32>
      %mask = pto.vmi.pset "PAT_ALL" : !pto.vmi.mask<64xpred>
      %sum = pto.vmi.vadd %lhs_vec, %rhs_vec, %mask
          : !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>, !pto.vmi.mask<64xpred>
          -> !pto.vmi.vreg<64xf32>
      pto.vmi.store %sum, %dst_view[%c0]
          : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>
    }

    return
  }

  func.func @vector_add_kernel(
      %sync_block_lock: !pto.ptr<ui8, gm>,
      %workspace: !pto.ptr<ui8, gm>,
      %lhs_gm: !pto.ptr<f32, gm>,
      %rhs_gm: !pto.ptr<f32, gm>,
      %dst_gm: !pto.ptr<f32, gm>,
      %arg5: i32,
      %arg6: i32,
      %arg7: i32) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c0_i64 = arith.constant 0 : i64
    %c1_i64 = arith.constant 1 : i64
    %c1024_i64 = arith.constant 1024 : i64

    %ctrl0 = pto.get_ctrl : i64
    %clear_bit60 = arith.constant -1152921504606846977 : i64
    %ctrl0_clear = arith.andi %ctrl0, %clear_bit60 : i64
    pto.set_ctrl %ctrl0_clear : i64

    %ctrl1 = pto.get_ctrl : i64
    %set_bit48 = arith.constant 281474976710656 : i64
    %ctrl1_set = arith.ori %ctrl1, %set_bit48 : i64
    pto.set_ctrl %ctrl1_set : i64

    %lhs_ub = pto.castptr %c0_i64 : i64 -> !pto.ptr<f32, ub>
    %rhs_ub = pto.castptr %c1024_i64 : i64 -> !pto.ptr<f32, ub>
    %dst_ub = pto.castptr %c0_i64 : i64 -> !pto.ptr<f32, ub>

    pto.mte_gm_ub %lhs_gm, %lhs_ub, %c0_i64, %c1024_i64
      nburst(%c1_i64, %c0_i64, %c0_i64)
      : !pto.ptr<f32, gm>, !pto.ptr<f32, ub>, i64, i64, i64, i64, i64
    pto.mte_gm_ub %rhs_gm, %rhs_ub, %c0_i64, %c1024_i64
      nburst(%c1_i64, %c0_i64, %c0_i64)
      : !pto.ptr<f32, gm>, !pto.ptr<f32, ub>, i64, i64, i64, i64, i64

    pto.set_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]
    pto.wait_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]

    func.call @vector_add_kernel_outlined_vf_0(%lhs_ub, %rhs_ub, %dst_ub)
      : (!pto.ptr<f32, ub>, !pto.ptr<f32, ub>, !pto.ptr<f32, ub>) -> ()

    pto.set_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.wait_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]

    pto.mte_ub_gm %dst_ub, %dst_gm, %c1024_i64
      nburst(%c1_i64, %c0_i64, %c0_i64) l2_cache_ctl(%c0_i64)
      : !pto.ptr<f32, ub>, !pto.ptr<f32, gm>, i64, i64, i64, i64, i64

    %ctrl2 = pto.get_ctrl : i64
    %set_bit60 = arith.constant 1152921504606846976 : i64
    %ctrl2_set = arith.ori %ctrl2, %set_bit60 : i64
    pto.set_ctrl %ctrl2_set : i64

    pto.barrier #pto.pipe<PIPE_ALL>
    return
  }
}
